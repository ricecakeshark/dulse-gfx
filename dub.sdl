name "kelp-gfx"
description "shared library of kelp"
authors "RiceShark"
copyright "Copyright © 2025, RiceShark"
license "proprietary"

dependency "kelp-core" path="..\\kelp_core"
dependency "kelp-sdl" path="..\\kelp_sdl"
dependency "bindbc-sdl" version="~>2.3.3"

targetType "sourceLibrary"
targetName "kelp_render"
targetPath "build"

//dflags "-H" "-Hd=include"
dflags "-preview=in"

versions "SDL_3_4_0" "SDL_Image_3_2" "SDL_TTF_3_2_2"
libs "SDL3" "SDL3_image" "SDL3_ttf"
